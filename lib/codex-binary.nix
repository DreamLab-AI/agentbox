# lib/codex-binary.nix
#
# Nix derivation for OpenAI's Rust-native Codex CLI.
# Release: https://github.com/openai/codex/releases/tag/rust-v0.163.0
#
# Uses the official pre-built musl package archives rather than
# buildRustPackage from source — faster, deterministic, and complete.  The
# package archive is important: modern Codex releases require the sibling
# codex-code-mode-host executable and discover bundled resources relative to
# the main binary.  The legacy single-binary archive is not a complete runtime.
#
# Per-arch SHA256s are generated by `./agentbox.sh update` (or directly with
# `./scripts/bump-codex-version.sh`). Do not hand-edit the version or hashes.
#
# Supported targets: x86_64-linux, aarch64-linux (musl).
# darwin / windows are NOT supported — agentbox is Linux-container-only; users
# on other hosts pull the published multi-arch image from GHCR.

{ lib, pkgs }:

let
  codexVersion = "0.163.0";
  baseUrl = "https://github.com/openai/codex/releases/download/rust-v${codexVersion}";

  # Map agentbox's system string to OpenAI's canonical package archive.
  # musl tarballs are chosen for container portability: all bundled executables
  # are static and run in our nix2container image regardless of the base libc.
  assets = {
    "x86_64-linux" = {
      name   = "codex-package-x86_64-unknown-linux-musl.tar.gz";
      sha256 = "582646c6bf0561eb0de540f7fc85b9121b0091a826bc6e96830b7f1722122182";
    };
    "aarch64-linux" = {
      name   = "codex-package-aarch64-unknown-linux-musl.tar.gz";
      sha256 = "9d8ecf2d19d3e184877983902d6c85de48b3888dcb72c382a8a0c975845927fb";
    };
  };

  assetFor = system:
    assets.${system} or (throw ''
      lib/codex-binary.nix: no Codex release asset for system "${system}".
      Supported: ${lib.concatStringsSep ", " (builtins.attrNames assets)}.
      For darwin/windows hosts, pull the published agentbox image from GHCR
      (which is always linux/amd64 or linux/arm64) rather than building
      natively.
    '');

in

{
  # Build a codex derivation for a given system string (e.g. "x86_64-linux").
  # Invoked from flake.nix when toolchainCfg.codex is enabled.
  makeCodex = system:
    let
      asset = assetFor system;
      tarball = pkgs.fetchurl {
        url    = "${baseUrl}/${asset.name}";
        inherit (asset) sha256;
      };
    in
    pkgs.stdenv.mkDerivation {
      pname   = "codex";
      version = codexVersion;

      src = tarball;

      # Upstream package tarballs have no wrapping directory.
      sourceRoot = ".";

      # No build required — pre-compiled binary.
      dontBuild = true;

      # Strip isn't needed (upstream already stripped).
      dontStrip = true;

      # Patchelf is unnecessary on musl. Keep every executable bit-identical to
      # the signed upstream package.
      dontPatchELF = true;

      installPhase = ''
        runHook preInstall

        # Preserve the canonical upstream package layout. Codex locates the
        # code-mode host beside itself and the sandbox/shell helpers through
        # codex-package.json relative to that executable.
        # Preserve all package resources. 0.163.0 removed its patched zsh;
        # the upstream manifest defines the helpers present in each release.
        mkdir -p $out
        cp -R bin codex-path codex-resources $out/
        install -Dm644 codex-package.json $out/codex-package.json

        runHook postInstall
      '';

      doInstallCheck = true;
      installCheckPhase = ''
        "$out/bin/codex" --version | grep -Fx "codex-cli ${codexVersion}"
        test -x "$out/bin/codex-code-mode-host"
        test -x "$out/codex-path/rg"
        test -x "$out/codex-resources/bwrap"
        test -s "$out/codex-package.json"
      '';

      meta = with lib; {
        description = "OpenAI's Rust-native Codex CLI and runtime helpers";
        homepage    = "https://github.com/openai/codex";
        license     = licenses.asl20;
        platforms   = builtins.attrNames assets;
        mainProgram = "codex";
      };
    };
}
