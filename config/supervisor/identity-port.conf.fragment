; Custody X-1 step 1, W3: the identity port (design §2.5; ADR-2122).
;
; FRAGMENT for W1's ISOLATED supervisor config (origin/custody/w1-role-accounts had
; not landed that config when this was written). It is Nix-templated text: paste it
; into the isolated config's generator in flake.nix (or lib/role-accounts.nix) and
; substitute the two @...@ placeholders from W1's role registry. Nothing reads this
; file at run time, so with role_isolation off it changes nothing.
;
; What W1's root phase must provide before supervisord starts (Stage A):
;   /run/secrets/identity/            ab-identity 0500
;   /run/secrets/identity/core.key    ab-identity 0400, AGENTBOX_PRIVKEY_HEX exactly as
;                                     supplied (NOT identity.json's normalised scalar;
;                                     the mirror child derives from it, src/mirror_key.rs)
;   /run/secrets/identity/junkiejarvis.key  ab-identity 0400 (optional; forum_event
;                                     is refused while it is absent)
;   /run/agentbox/                    root:ab-identity 1775 (root-owned; the sticky bit
;                                     stops anyone but the owner replacing the socket;
;                                     serve-identity refuses a world-writable dir without it)
;   /var/lib/agentbox/events/sign/    ab-identity:devuser 2750 (receipts, devuser reads)
;   group ab-identity-port            members: devuser and every caller role in
;                                     config/custody/identity-port-acl.json
;
; The socket is created by serve-identity at /run/agentbox/identity.sock, owner
; ab-identity, group ab-identity-port, mode 0660. The group only narrows who can
; connect; authorisation is the SO_PEERCRED uid against the ACL.
;
; `env -i` keeps PID 1's inherited .env (AGENTBOX_PRIVKEY_HEX and the rest; design §0
; bypass 3) out of this process: the key arrives only through the 0400 file.
; With [security].role_isolation off the program prints one line and exits 0
; (status EXITED, expected), exactly like docker-read-proxy.

[program:identity-port]
command=${pkgs.bash}/bin/bash -c 'exec ${pkgs.coreutils}/bin/env -i AGENTBOX_ROLE_ISOLATION="''${AGENTBOX_ROLE_ISOLATION:-0}" RUST_LOG=info AGENTBOX_IDENTITY_ACL=/opt/agentbox/config/custody/identity-port-acl.json AGENTBOX_IDENTITY_KEY_DIR=/run/secrets/identity AGENTBOX_IDENTITY_SOCK=/run/agentbox/identity.sock AGENTBOX_IDENTITY_SOCK_GID=@IDENTITY_PORT_GID@ AGENTBOX_IDENTITY_RECEIPT_DIR=/var/lib/agentbox/events/sign AGENTBOX_CONFIG=/etc/agentbox.toml ${nostrPodBridgePkg}/bin/nostr-pod-bridge serve-identity'
directory=/
user=@IDENTITY_USER@
autostart=true
autorestart=unexpected
exitcodes=0
startsecs=0
priority=30
stopsignal=TERM
stdout_logfile=/var/log/identity-port.log
stderr_logfile=/var/log/identity-port.error.log
