{
  "name": "comfyui-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for ComfyUI workflow orchestration",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test server.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "comfyui",
    "stable-diffusion",
    "image-generation",
    "workflow-automation"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.5.12",
    "eslint": "^9.39.5",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/claude-flow"
  },
  "author": "Claude Flow Team",
  "license": "MIT",
  "config": {
    "comfyui_url": "http://localhost:8188",
    "output_dir": "/tmp/comfyui-outputs",
    "max_concurrent_workflows": 4,
    "metrics_port": 9091
  }
}
