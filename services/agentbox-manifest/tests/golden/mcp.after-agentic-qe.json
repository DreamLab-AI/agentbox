{
  "mcpServers": {
    "claude-flow": {
      "command": "node",
      "args": [
        "/opt/agentbox/mcp/servers/ruvector-mcp.cjs"
      ],
      "type": "stdio",
      "env": {
        "RUVECTOR_PG_CONNINFO": "host=x",
        "NODE_PATH": "/np"
      }
    },
    "ruvector": {
      "command": "node",
      "args": [
        "/home/devuser/.claude/ruvector-mcp.cjs"
      ],
      "type": "stdio"
    },
    "browser-gpu": {
      "type": "sse",
      "url": "http://browsercontainer:8931/sse"
    },
    "agentic-qe": {
      "command": "aqe",
      "args": [
        "mcp"
      ],
      "type": "stdio",
      "env": {
        "AQE_MEMORY_BACKEND": "memory",
        "AQE_VERBOSE": "false",
        "NODE_NO_WARNINGS": "1",
        "AQE_LLM_PROVIDER": "claude-code"
      }
    }
  }
}