# Nix
result
result-*
.direnv/

# Sovereign runtime artifacts (pod-git roots + version cache written at bootstrap/test)
pods/
cache/

# Node.js
# Ignore dependency trees and runtime-created node_modules symlinks. A trailing
# slash matches directories only, allowing container-local absolute symlinks to
# appear as untracked files.
node_modules
npm-debug.log*
.npm
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
*.egg
.venv/
venv/

# Rust
target/
*.rlib

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
debug_log.txt

# Environment — ignore every .env variant by default; only templates/examples
# are tracked. (.env.dreamlab-additions slipped through the old narrow patterns.)
.env
.env.*
!.env.example
!.env.template
!.env.template.*
!.env.*.example
!.env.*.template
# Local audit scratch (redacted env survey) and agentic-qe runtime state (witness keys)
env-redacted.txt
.agentic-qe/

# Runtime directories (created by container)
workspace/
projects/

# Build artifacts
dist/
!setup/frontend/dist/
build/
out/
*.tar
*.tar.gz
*.local

# Test artifacts
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp
.cache/
.temp/

# Databases
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Claude Flow
.claude-flow/
.multi-agent/
.hive-mind/
.swarm/
claude-flow
claude-flow.bat
claude-flow.ps1
hive-mind-prompt-*.txt
agentdb.db*
.claude

# MCP
.mcp.json
mcp-logs/

# Media (keep repo light)
*.mp4
#*.webm
*.mov
*.wav
*.mp3
*.glb
*.gltf
*.hdr
*.exr
#*.gif
#*.jpeg
#*.png

# CUDA (not used but keep for safety)
*.ptx

# Docker
.docker/
docker-compose.override.yml

# Certificates
certs/
*.pem
# Voice operator console self-signed TLS (generated by `agentbox.sh voice up`);
# covered by the globs above, listed explicitly so the never-commit rule is loud.
voice/console/certs/

# Generated
generated/
screenshots/
test-results/

# Hardened skill directory rules (prevent build artefacts)
skills/**/node_modules/
skills/**/target/
skills/**/dist/
skills/**/__pycache__/
skills/**/.DS_Store
skills/**/backups/
portfinder-*.tgz

.env.solid-pods

# ruvector sidecar update/backup artefacts (pg dumps, snapshots state)
/backups/

# OpenMed provisioned model + helix pipeline (licence-gated, never committed)
openmed-sidecar/model/
openmed-sidecar/server/
# Podcast promotion pipeline runtime state and generated dossiers
skills/podcast-knowledge-ingest/promotions/

# runtime junk / secrets — never commit
**/.claude-flow/
**/.agentic-qe/
*.key.pem
