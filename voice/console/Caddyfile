{
	auto_https off
}

# ── :8444 — THE operator surface (agentbox voice + AoE cockpit) ────────────
# Single self-signed TLS origin consolidating every surface the operator
# cockpit needs, all same-origin so the browser can reach them under one mic
# secure-context and one NIP-98 / bearer credential:
#   /            static console page (agentbox "Industrial Warmth" system, /srv)
#   /embed       compact voice strip (forked Unmute frontend, same-origin
#                iframe → mic permission needs no cross-origin delegation)
#   /_next/*     Next.js assets + HMR websocket for /embed
#   /api/*       Unmute backend (health, voices, /v1/realtime websocket)
#   /feed        tab0-bridge live turn feed (websocket) — Authorization forwarded
#   /bridge/*    tab0-bridge REST (tabs, tab0/send, nostr/*) — Authorization forwarded
#   /aoe/*       AoE sessions via the NIP-98 sole-ingress proxy (agentbox:9096)
#   /approvals/* management-api governance approvals (agentbox:9090)
#   /mgmt/*      authenticated management API reads used by the cockpit
#   /lo/*        public linked-object viewer bundle
#   /docs/*      public Swagger shell (API operations still authenticate)
# Mic needs a secure context; the browser shows a one-time warning for the
# self-signed cert — proceed.
#
# AUTH: the console signs a NIP-98 (kind-27235) header via window.nostr, or
# falls back to a break-glass bearer. reverse_proxy forwards all request
# headers (incl. Authorization) to upstreams by default; the header_up lines
# below are explicit so the tab0-bridge global-auth path (Part A finding 1)
# and the NIP-98 proxy both receive the operator credential intact.
https://:8444 {
	tls /certs/cert.pem /certs/key.pem

	handle /embed* {
		reverse_proxy frontend:3000
	}
	handle /_next/* {
		reverse_proxy frontend:3000
	}
	# Opus worker + audio-worklet assets: the frontend loads these from
	# root-absolute paths (see useAudioProcessor.ts) out of Next's public/.
	# Without this route they fall through to the static console site and
	# 404 — which kills audio setup right after the mic prompt.
	@voiceassets path /audio-output-processor.js /decoderWorker.min.js /decoderWorker.min.wasm /encoderWorker.min.js
	handle @voiceassets {
		reverse_proxy frontend:3000
	}
	handle_path /api/* {
		reverse_proxy backend:80
	}
	# ── AoE session board (the main stage) ──────────────────────────────
	# The sole ingress to the aoe serve daemon (loopback :9095) is the
	# NIP-98 proxy on :9096. Same-origin so the console can call /aoe/api/*
	# with the operator's signed header (which the proxy verifies → session
	# pubkey). Includes the session live-ws ANSI streams (websocket upgrade).
	handle_path /aoe/* {
		reverse_proxy agentbox:9096 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	# ── Governance approvals (operator-gated, Part A finding 2) ──────────
	# management-api :9090 serves GET /v1/approvals and
	# POST /v1/approvals/:id/decide. The console signs a NIP-98 request; the
	# decision is operator/allowlist-gated server-side.
	handle_path /approvals/* {
		reverse_proxy agentbox:9090 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	handle_path /mgmt/* {
		reverse_proxy agentbox:9090 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	handle /lo* {
		reverse_proxy agentbox:9090
	}
	handle /docs* {
		reverse_proxy agentbox:9090
	}
	# management-api :9090 serves GET /dream/status (ADR-055) — a read-only view
	# over the dream engine's per-repo ledgers. Operator-gated server-side, so the
	# console forwards the signed Authorization header (as for /approvals). No path
	# strip: the API sees /dream/*. The view itself is the static /dream.html below.
	handle /dream/* {
		reverse_proxy agentbox:9090 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	handle /feed {
		reverse_proxy agentbox:8971 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	handle_path /bridge/* {
		reverse_proxy agentbox:8971 {
			header_up Authorization {http.request.header.Authorization}
		}
	}
	handle {
		root * /srv
		file_server
	}
}

# ── :8443 — DEBUG ONLY: full stock Unmute demo UI ──────────────────────────
# Not part of the operator path; keep for diagnosing the voice loop with the
# upstream interface. Routes directly to the unmute services — traefik is not
# in this path.
https://:8443 {
	tls /certs/cert.pem /certs/key.pem

	handle_path /api/* {
		reverse_proxy backend:80
	}
	handle {
		reverse_proxy frontend:3000
	}
}
