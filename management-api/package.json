{
  "name": "agentbox-management-api",
  "version": "1.0.0",
  "description": "Sovereign Agentbox management and governance API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest && npm run test:node",
    "test:node": "node --test ../tests/contract/harness-bridge.contract.spec.js ../tests/contract/upstream_vectors/all_fixtures.test.js ../tests/sovereign/zone-keys.node-test.js ../tests/sovereign/nip98-host-port.node-test.js ../tests/sovereign/chain-info.node-test.js ../tests/sovereign/pod-sovereign-signer.node-test.js ../tests/sovereign/identity-port.node-test.js ../tests/sovereign/sidestr-spend-key.node-test.js ../tests/sovereign/chain-payments.node-test.js ../tests/sovereign/dispatch-as.node-test.js ../tests/sovereign/sidechain-health.node-test.js ../tests/sovereign/sidechain-witness.node-test.js"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests/contract",
      "<rootDir>/tests/sovereign",
      "<rootDir>/tests/integration"
    ],
    "testMatch": [
      "**/*.contract.spec.js",
      "**/*.test.js"
    ],
    "testEnvironment": "node",
    "rootDir": "..",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/docker/",
      "/tests/contract/upstream_vectors/",
      "/tests/contract/harness-bridge.contract.spec.js"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/",
      "/docker/"
    ]
  },
  "keywords": [
    "management",
    "api",
    "agentic-flow"
  ],
  "author": "DreamLab AI",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "jest": "^30.5.2",
    "portfinder": "^1.0.38",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.12.5",
    "jsonld": "^9.0.0",
    "nostr-tools": "2.25.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0"
  }
}
