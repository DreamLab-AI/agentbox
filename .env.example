# Agentbox runtime environment
#
# Copy this file to .env, review every REQUIRED entry, then run:
#   cp .env.example .env
#   ./agentbox.sh preflight
#
# agentbox.toml selects features and supplies image-build defaults. This file
# supplies secrets, host paths, deployment identity, and runtime overrides.
# Docker Compose reads it on the host and also passes it into the main agentbox
# container. Never commit the populated .env file.
#
# Labels used below:
#   REQUIRED       Needed by the normal Compose stack.
#   FEATURE        Needed only when the named feature or sidecar is enabled.
#   OVERRIDE       A working default exists; change only when required.
#
# Keep assignments shell-free: KEY=value. Quote values only when Compose needs
# to preserve spaces or special characters. Empty optional values are disabled.

# -----------------------------------------------------------------------------
# Image and host mounts
# -----------------------------------------------------------------------------

# OVERRIDE: image built or pulled by agentbox.sh.
AGENTBOX_IMAGE_REF=

# REQUIRED: absolute host directories mounted as project workspaces.
PROJECT_DIR=/mnt/mldata/githubs/AR-AI-Knowledge-Graph
PROJECT_DIR_2=/mnt/mldata/githubs/dreamlab-ai-website
PROJECT_DIR_3=/mnt/mldata/githubs/dreamlab-cumbria
PROJECT_DIR_4=/mnt/mldata/githubs/logseq

# OVERRIDE: optional alternate host Claude directory. The standard mounts use
# the host's $HOME automatically; leave this empty unless intentionally linking
# another directory.
HOST_CLAUDE_PATH=

# Container identity and local timezone.
AGENTBOX_AGENT_ID=agentbox-core
TZ=Europe/London

# Optional Compose resource overrides.
AGENTBOX_CPU_LIMIT=
AGENTBOX_MEM_LIMIT=
AGENTBOX_CPU_RESERVE=
AGENTBOX_MEM_RESERVE=

# -----------------------------------------------------------------------------
# Model providers and developer services
# -----------------------------------------------------------------------------

# No cloud key is universally required: the default stack can use local Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_MODEL=

# The three Gemini names are retained because different bundled tools read
# different aliases. Set the same key in each variable when Gemini is used.
GOOGLE_API_KEY=
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

OPENROUTER_API_KEY=
OR_MODEL=nvidia/nemotron-3-super-120b-a12b:free

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

OLLAMA_BASE_URL=http://192.168.2.132:8084/v1
OLLAMA_MODEL=gemma-4-31B-it-qat
GEMMA_BASE_URL=http://192.168.2.132:8084/v1
GEMMA_MODEL=gemma-4-31B-it-qat
LOCAL_LLM_HOST=192.168.2.132
LOCAL_LLM_PORT=8080

GITHUB_TOKEN=
CRATES_TOKEN=
E2B_API_KEY=

# Z.AI uses two endpoint names in the bundled tools. ZAI_URL is the general
# endpoint; ZAI_BASE_URL is consumed by the Claude wrapper.
ZAI_API_KEY=
ZAI_ANTHROPIC_API_KEY=
ZAI_URL=https://api.z.ai/api/anthropic
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_CONTAINER_URL=http://localhost:9600
ZAI_TIMEOUT=60
ZAI_WRAPPER_TOKEN=
ZAI_ALLOWED_TOOLS=Read,Grep,Glob,Bash,Edit,Write
ZAI_DANGEROUS=false

# -----------------------------------------------------------------------------
# Management API, interaction plane, and ingress
# -----------------------------------------------------------------------------

# Blank MANAGEMENT_API_KEY is generated at first boot. Set it explicitly for a
# stable bearer credential shared with external clients.
MANAGEMENT_API_KEY=
MANAGEMENT_API_AUTH_MODE=hybrid
MANAGEMENT_API_URL=http://127.0.0.1:9090
MANAGEMENT_API_HOST=0.0.0.0
MANAGEMENT_API_PORT=9090

# Agent of Empires interaction plane and tab-0 voice bridge.
AGENTBOX_INTERACTION_PLANE=1
AGENTBOX_INTERACTION_PLANE_PORT=9095
AOE_COORDINATOR_TITLE=tab0

BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8971
BRIDGE_MODEL=haiku
BRIDGE_TMUX_SESSION=agentbox
BRIDGE_URL=http://127.0.0.1:8971
# FEATURE/REQUIRED for voice or any non-loopback bridge bind.
BRIDGE_TOKEN=

# NIP-98 front door. Supply a stable session secret in deployed environments.
NIP98_PROXY_HOST=0.0.0.0
NIP98_PROXY_PORT=9096
NIP98_PROXY_SESSION_SECRET=
NIP98_PROXY_SESSION_TTL=43200
NIP98_PROXY_ALLOWED_PUBKEYS=
NIP98_PROXY_ROUTES=
NIP98_PROXY_MGMT_UPSTREAM=http://127.0.0.1:9090
NIP98_PROXY_MAX_BODY=26214400
# Break-glass bearer access; normally use the bridge token or leave disabled.
NIP98_PROXY_ALLOW_BEARER=
NIP98_PROXY_BEARER_PUBKEY=break-glass

# -----------------------------------------------------------------------------
# Memory, embeddings, and ontology
# -----------------------------------------------------------------------------

# REQUIRED: Compose refuses to start without this value. `ruvector` is the
# local-development default used by the bundled sidecar. Replace it with a
# strong password before exposing PostgreSQL beyond the private Compose network,
# and keep the value unchanged for an existing PostgreSQL data volume.
RUVECTOR_PG_PASSWORD=ruvector
RUVECTOR_PG_CONNINFO=
RUVECTOR_USE_EXTERNAL=true

# OVERRIDE: internal Xinference defaults.
XINFERENCE_ENDPOINT=http://xinference:9997
EMBEDDING_MODEL=bge-small-en-v1.5

# Advanced memory policy overrides.
RUVECTOR_ADMIN_WRITE=false
RUVECTOR_PROTECTED_NAMESPACES=governance-precedents
RUVECTOR_TYPED_METADATA=true
RUVECTOR_HYBRID_SEARCH=true

# Ontology consultant and enrichment settings.
ONTOLOGY_INJECT=1
CONSULT_ONTOLOGY_AUGMENT=1
CONSULT_ONTOLOGY_MAX_TOKENS=
ONTOLOGY_PUSH_MIN_RELEVANCE=0.11
ONTOLOGY_TIMEOUT_MS=10000
ONTOLOGY_ENRICH_UK_ENGLISH=true
ONTOLOGY_ENRICH_RATE_LIMIT=10
ONTOLOGY_ENRICH_CITATION_MIN_RELEVANCE=0.7
ONTOLOGY_ENRICH_AUTO_ROLLBACK=true
ONTOLOGY_ENRICH_KG_ROOT=mainKnowledgeGraph/pages
ONTOLOGY_ENRICH_LOG_LEVEL=INFO
ONTOLOGY_ENRICH_LOG_FILE=logs/enrichment.log

# -----------------------------------------------------------------------------
# Sovereign identity, relay, and session mirror
# -----------------------------------------------------------------------------

# Provide AGENTBOX_NSEC or AGENTBOX_PRIVKEY_HEX to retain a specific identity.
# If both are blank, bootstrap generates one in the identity volume.
AGENTBOX_NSEC=
AGENTBOX_PRIVKEY_HEX=
AGENTBOX_NPUB=
AGENTBOX_PUBKEY=
AGENTBOX_X_ONLY_PUBKEY_HEX=
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net

AGENTBOX_RELAY_BIND=127.0.0.1:7777
AGENTBOX_ALLOWED_PUBKEYS=
AGENTBOX_RELAY_ALLOWED_PUBKEYS=
AGENTBOX_RELAY_POLICY=allowlist
AGENTBOX_RELAY_FANOUT=off

AGENTBOX_NOSTR_GATEWAY=1
AGENTBOX_TAB0_BRIDGE_URL=http://127.0.0.1:8971
AGENTBOX_LIVE_MIRROR=
AGENTBOX_MIRROR_CHILD=
AGENTBOX_MIRROR_DRY_RUN=
AGENTBOX_MIRROR_KEY_TAG=
AGENTBOX_MIRROR_RECIPIENT_PUBKEY=
NOSTR_MIRROR_RELAY=

# -----------------------------------------------------------------------------
# Optional agents and external integrations
# -----------------------------------------------------------------------------

JUNKIEJARVIS_ENABLED=true
JUNKIEJARVIS_PRIVKEY_HEX=
JUNKIEJARVIS_PUBKEY=
JUNKIEJARVIS_NOSTR_RELAYS=
JUNKIEJARVIS_LLM_BASE=https://api.z.ai/api/paas/v4
JUNKIEJARVIS_LLM_KEY=
JUNKIEJARVIS_MODEL=
JUNKIEJARVIS_MAX_REPLY=280
PER_USER_AGENTS_ENABLED=
PER_USER_POD_BASE=

AGENTBOX_EMAIL_GATEWAY_TOKEN=
AGENTBOX_EMAIL_GATEWAY_URL=

VISIONCLAW_AGENT_KEY=
VISIONCLAW_API_URL=http://visionclaw-server:4000
# Bearer token for the bridge's power_user (SPARQL-backed) reads. On a VisionClaw
# dev build this MUST be the literal dev-session bearer `dev-session-token`
# (paired with AGENTBOX_PUBKEY as the X-Nostr-Pubkey identity) — a bare pubkey as
# the bearer returns 403. Release builds authenticate via NIP-98 signing instead.
VISIONCLAW_DEV_TOKEN=

TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=agentbox

# -----------------------------------------------------------------------------
# Search, research, and media provider keys
# -----------------------------------------------------------------------------

CERAMIC_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
CONTEXT7_API_KEY=
BRAVE_API_KEY=
SEARCHAPI_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=

FAL_KEY=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
REMOVEBG_API_KEY=
DEEPGRAM_API_KEY=

# Nano-Banana currently reads OPENROUTER_KEY rather than OPENROUTER_API_KEY.
OPENROUTER_KEY=

# -----------------------------------------------------------------------------
# ComfyUI and GUI sidecars
# -----------------------------------------------------------------------------

COMFYUI_URL=http://localhost:8188
COMFYUI_WS_URL=ws://localhost:8188/ws
COMFYUI_API_ENDPOINT=
COMFYUI_LOCAL_ENDPOINT=http://172.18.0.10:8188
COMFYUI_OUTPUT_DIR=/home/devuser/ComfyUI/output
COMFYUI_OUTPUTS=/run/comfyui/output
COMFYUI_TIMEOUT=300000
COMFYUI_RETRY_ATTEMPTS=3
COMFYUI_RETRY_DELAY=2000
SALAD_API_KEY=
SALAD_ORG_NAME=default-org

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
BLENDER_PORT=9876
QGIS_PORT=9877
QGIS_HOST=localhost
QGIS_TIMEOUT=60
PBR_PORT=9878
MCP_TCP_PORT=9500
WLR_BACKENDS=headless

# -----------------------------------------------------------------------------
# Bundled skill configuration
# -----------------------------------------------------------------------------

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
LINKEDIN_TIMEOUT=5000

DEFENSE_MCP_DRY_RUN=true
DEFENSE_MCP_REQUIRE_CONFIRMATION=true
DEFENSE_MCP_ALLOWED_DIRS=/tmp,/home,/var/log
DEFENSE_MCP_LOG_LEVEL=info

ECHOLOOP_LLM_PROVIDER=anthropic
ECHOLOOP_TRANSCRIBER=local
ECHOLOOP_WHISPER_MODEL=base.en
ECHOLOOP_WHISPER_DEVICE=cpu
ECHOLOOP_SYSTEM_DEVICE=
ECHOLOOP_MIC_DEVICE=
ECHOLOOP_LOG_DIR=/tmp/echoloop-sessions

CBM_CACHE_DIR=/home/devuser/.cache/codebase-memory-mcp
IMAGEMAGICK_TIMEOUT=300
DOCKER_SOCKET_PATH=/var/run/docker.sock

# -----------------------------------------------------------------------------
# Optional runtime profiles and sidecars
# -----------------------------------------------------------------------------

# Native Solid pod stack (docker-compose.solid-pods.yml).
CLOUDFLARE_TUNNEL_TOKEN=
SOLID_ADMIN_KEY=
SOLID_ALLOWED_ORIGINS=https://dreamlab-ai.com
SOLID_POD_PUBLIC_URL=https://pods-native.dreamlab-ai.com
SOLID_POD_PORT=8484
SOLID_POD_ROOT=/var/lib/solid

# OpenMed governance-gated sidecar.
OPENMED_LICENSE_ACKNOWLEDGED=false
OPENMED_ONNX_RUNTIME_PRESENT=false
OPENMED_GOVERNANCE_ACKNOWLEDGED=false
OPENMED_MODEL_ARTIFACT=
OPENMED_ARTIFACT_LOCK_SHA256=
OPENMED_HMAC_KEY_TAG=agentbox-openmed-v1
OPENMED_MODEL_DIR=./openmed-sidecar/model
OPENMED_SERVER_DIR=./openmed-sidecar/server

# Android and XR profiles.
AGENTBOX_ENABLE_ANDROID=false
ANDROID_IMAGE=redroid/redroid:13-mtg
XR_PROJECT_ROOT=..
XR_INPUT_DRIVER=simulated
XR_RUNTIME_HEADLESS=0

# Host paths used by `agentbox.sh voice`; normally calculated automatically.
VOICE_HOST_ROOT=
VOICE_UNMUTE_DIR=
VOICE_CONSOLE_DIR=
