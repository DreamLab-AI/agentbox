    { "method": "GET",    "path": "/containers/agentbox/top",                 "allow": false, "why": "not on the allowlist" },
    { "method": "GET",    "path": "/containers/agentbox/stats",               "allow": false, "why": "not on the allowlist" },
    { "method": "GET",    "path": "/images/json",                             "allow": false, "why": "not on the allowlist" },
