    { "method": "GET",    "path": "/v1.47/containers/json?all=1",             "allow": true,  "why": "docker ps -a" },
    { "method": "GET",    "path": "/containers/json?filters=%7B%22name%22%3A%7B%22agentbox%22%3Atrue%7D%7D", "allow": true, "why": "docker ps --filter" },
    { "method": "GET",    "path": "/v1.47/containers/agentbox/json",          "allow": true,  "why": "docker inspect" },
