    { "method": "POST",   "path": "/containers/agentbox/start",               "allow": false, "why": "start" },
    { "method": "POST",   "path": "/containers/agentbox/kill",                "allow": false, "why": "kill" },
    { "method": "DELETE", "path": "/containers/agentbox",                     "allow": false, "why": "rm" },
