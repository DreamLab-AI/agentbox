Prefix(dl:=<https://narrativegoldmine.com/ns/dl#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(memory:=<http://nova.dev/memory#>)

Ontology(<https://narrativegoldmine.com/ns/dl> <https://narrativegoldmine.com/ns/dl/2>
  Annotation(owl:versionInfo "2")
  Annotation(rdfs:comment "Decision-layer vocabulary (ADR-048/ADR-049). OWL 2 EL profile: no inverse, functional, or inverse-functional properties. dl:caused and dl:precedentFor are deliberately NOT transitive - reachability is query-derived and must remain distinguishable from direct evidence. Functional-syntax projection of decision-layer.ttl for the horned-owl/Whelk loader; keep in sync with the TTL.")

  Declaration(Class(dl:DecisionRecord))
  Declaration(Class(prov:Activity))
  Declaration(Class(prov:Entity))
  Declaration(ObjectProperty(dl:caused))
  Declaration(ObjectProperty(dl:precedentFor))
  Declaration(ObjectProperty(dl:influenced))
  Declaration(ObjectProperty(dl:consideredInput))
  Declaration(ObjectProperty(dl:governedBy))
  Declaration(DataProperty(dl:validFrom))
  Declaration(DataProperty(dl:validTo))
  Declaration(Class(dl:Closure))
  Declaration(Class(memory:Clock))
  Declaration(ObjectProperty(dl:closesVersion))
  Declaration(ObjectProperty(dl:closes))
  Declaration(DataProperty(dl:validUntil))
  Declaration(DataProperty(dl:reason))
  Declaration(DataProperty(dl:writer))

  SubClassOf(dl:DecisionRecord prov:Activity)

  ObjectPropertyDomain(dl:caused dl:DecisionRecord)
  ObjectPropertyRange(dl:caused dl:DecisionRecord)
  ObjectPropertyDomain(dl:precedentFor dl:DecisionRecord)
  ObjectPropertyRange(dl:precedentFor dl:DecisionRecord)
  ObjectPropertyDomain(dl:influenced dl:DecisionRecord)
  ObjectPropertyRange(dl:influenced dl:DecisionRecord)
  ObjectPropertyDomain(dl:consideredInput dl:DecisionRecord)
  ObjectPropertyRange(dl:consideredInput prov:Entity)
  ObjectPropertyDomain(dl:governedBy dl:DecisionRecord)
  ObjectPropertyRange(dl:governedBy prov:Entity)

  DataPropertyRange(dl:validFrom xsd:dateTime)
  DataPropertyRange(dl:validTo xsd:dateTime)

  ObjectPropertyDomain(dl:closesVersion dl:Closure)
  ObjectPropertyRange(dl:closesVersion prov:Entity)
  ObjectPropertyDomain(dl:closes dl:Closure)
  ObjectPropertyRange(dl:closes memory:Clock)
  DataPropertyDomain(dl:validUntil dl:Closure)
  DataPropertyRange(dl:validUntil xsd:dateTime)
  DataPropertyDomain(dl:reason dl:Closure)
  DataPropertyRange(dl:reason xsd:string)
  DataPropertyDomain(dl:writer prov:Activity)
  DataPropertyRange(dl:writer xsd:string)

  AnnotationAssertion(rdfs:comment dl:DecisionRecord "A first-class, did:nostr-attributed agent decision. IS-A prov:Activity so it inherits runtime-provenance plumbing (ADR-048).")
  AnnotationAssertion(owl:deprecated dl:validTo "true"^^xsd:boolean)
  AnnotationAssertion(rdfs:comment dl:validFrom "Inclusive start of an assertion-version's valid time. No domain, deliberately (estate-temporal-v2).")
  AnnotationAssertion(rdfs:comment dl:validTo "RETIRED from assertion-versions under estate-temporal-v2: an end is a dl:Closure with dl:validUntil. Kept only to read version-1 data until refitted.")
  AnnotationAssertion(rdfs:comment dl:Closure "Closes one assertion-version on one or both clocks (memory:ValidTime, memory:RecordedTime from the Agent Memory Ontology, CC BY 4.0, referenced by IRI). Not a version; never closed; closes at least one clock (writer-enforced).")
  AnnotationAssertion(rdfs:seeAlso dl:closes memory:ValidTime)
  AnnotationAssertion(rdfs:seeAlso dl:closes memory:RecordedTime)
  AnnotationAssertion(rdfs:comment dl:writer "Names the writer that owns an activity, as a plain string.")
  AnnotationAssertion(rdfs:comment dl:caused "Direct decision-to-decision causation claim. NOT transitive; ancestry is query-derived (ADR-048).")
  AnnotationAssertion(rdfs:comment dl:precedentFor "Direct, evidenced precedent claim. NOT transitive (ADR-048).")
)
